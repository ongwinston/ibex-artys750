  verification_sim:
    default: &default_target
    default_tool: xsim
    filesets_append:
      - files_verification_guide
    toplevel: tbench_top
    tools:
      xsim:
        xelab_options:
          - '-v2'
          - '-d ICARUS=1'
        xsim_options:

